rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Denegación por defecto. Las reglas específicas de abajo habilitan
    // únicamente los accesos necesarios.
    match /{document=**} {
      allow read, write: if false;
    }

    // Compatibilidad temporal con documentos antiguos del profesional.
    // El UID real debe estar autenticado; el identificador antiguo no es
    // una credencial y no autoriza a otros usuarios.
    function isOwner(ownerId) {
      return request.auth != null &&
        (
          request.auth.uid == ownerId ||
          (
            request.auth.uid == "NDmjbTte6wa5vgeIc2JASOfNhYi1" &&
            ownerId == "default_psychologist_uid_123"
          )
        );
    }

    function validPublicSlot(data) {
      return data.keys().hasOnly([
          "id", "date", "timeSlot", "status", "ownerId", "createdAt"
        ]) &&
        data.id is string &&
        data.date is string &&
        data.timeSlot is string &&
        data.status in ["scheduled", "canceled"] &&
        data.ownerId is string;
    }

    // Fichas administrativas de pacientes: solo el profesional autenticado
    // dueño de la ficha. El acceso del paciente debe migrarse a un flujo
    // autenticado; RUT y correo por sí solos no son autenticación.
    match /patients/{patientId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
    }

    // Citas: no exponer documentos completos al público. La reserva pública
    // debe pasar por una API que valide identidad mínima, disponibilidad,
    // importe y creación atómica del registro y del bloque público.
    match /appointments/{apptId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
    }

    // Evoluciones clínicas: solo profesional propietario.
    match /histories/{recordId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
    }

    // Los registros de auditoría no pueden alterarse ni borrarse desde el
    // cliente después de su creación.
    match /audit_logs/{logId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
      allow update, delete: if false;
    }

    match /clinical_audits/{logId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
      allow update, delete: if false;
    }

    // Las reseñas públicas deben ser moderadas y registradas por una API
    // protegida antes de publicarse.
    match /reviews/{reviewId} {
      allow read: if resource.data.publicConsent == true;
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId) &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(resource.data.ownerId);
    }

    // El diario de ánimo contiene datos de salud. El flujo actual no acredita
    // la identidad del paciente, por lo que se bloquea hasta implementar
    // autenticación individual y permisos por titular.
    match /mood_journals/{logId} {
      allow read, write: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
    }

    // Configuración privada del consultorio. Los datos que deban mostrarse
    // públicamente deben publicarse en un documento separado y minimizado.
    match /settings/{settingsId} {
      allow read: if isOwner(settingsId) || isOwner(resource.data.ownerId);
      allow create: if isOwner(settingsId) || isOwner(request.resource.data.ownerId);
      allow update, delete: if isOwner(settingsId) || isOwner(resource.data.ownerId);

      match /private/{document=**} {
        allow read, write: if isOwner(settingsId);
      }
    }

    // Disponibilidad pública sin nombre, RUT, contacto, notas ni vínculo
    // con el ID privado de la cita.
    match /public_booked_slots/{slotId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.ownerId) &&
        validPublicSlot(request.resource.data);
      allow update: if isOwner(resource.data.ownerId) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        validPublicSlot(request.resource.data);
      allow delete: if isOwner(resource.data.ownerId);
    }
  }
}
